{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt && (cd frontend && npm install); echo '✅ Packages installed and Requirements met'",
  "portsAttributes": {
    "5173": {
      "label": "Client",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "API"
    }
  },
  "forwardPorts": [
    5173,
    8000
  ]
}
