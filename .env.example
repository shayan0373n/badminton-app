# Copy to .env beside this file on the server and fill in. Never commit the real one.
#
# The hostname is not here: it is part of the Traefik label in compose.yaml,
# following the convention used by the other apps on the host.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_...

LOG_LEVEL=INFO
